FROM docker.io/library/composer:2 AS composer

FROM docker.io/library/php:8.4-fpm-alpine

RUN apk add --no-cache nginx oniguruma \
    && apk add --no-cache --virtual .build-deps $PHPIZE_DEPS oniguruma-dev \
    && docker-php-ext-install -j"$(nproc)" mbstring opcache \
    && apk del .build-deps

COPY --from=composer /usr/bin/composer /usr/bin/composer

WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --prefer-dist \
    --classmap-authoritative \
    --no-scripts

COPY . ./
RUN composer dump-autoload --classmap-authoritative --no-scripts \
    && php artisan package:discover --ansi \
    && mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs \
    && chown -R www-data:www-data storage bootstrap/cache

COPY docker/nginx.conf /etc/nginx/nginx.conf
COPY docker/fpm.conf /usr/local/etc/php-fpm.d/zz-public-apis.conf
COPY docker/opcache.ini /usr/local/etc/php/conf.d/zz-public-apis.ini

ENV APP_ENV=production \
    APP_DEBUG=false \
    APP_TIMEZONE=America/Sao_Paulo \
    CACHE_STORE=file \
    LOG_CHANNEL=stderr \
    LOG_LEVEL=error \
    GETIP_RATE_LIMIT=1000000 \
    GETUUID_RATE_LIMIT=1000000

USER www-data
EXPOSE 8080
CMD ["sh", "-c", "export APP_KEY=\"base64:$(php -r 'echo base64_encode(random_bytes(32));')\"; php artisan config:cache >/dev/null; nginx; exec php-fpm -F"]
