# MaxMind GeoLite2 (obrigatório). No Dokploy, cadastre na aba Environment; nunca no Git.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# Confie apenas no proxy reverso. No Dokploy use a sub-rede da rede do Traefik
# (docker network inspect dokploy-network), ex.: 172.16.0.0/12. Vazio = acesso direto.
TRUSTED_PROXY_CIDRS=

GEOIP_RELOAD_INTERVAL=5m
